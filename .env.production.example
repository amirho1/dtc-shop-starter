# Required Dokploy variables. Generate URL-safe secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=<64-character-hex-value>
REDIS_PASSWORD=<64-character-hex-value>
JWT_SECRET=<64-character-hex-value>
COOKIE_SECRET=<different-64-character-hex-value>
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=<unique-strong-admin-password>
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_<your-medusa-publishable-key>

# Public URLs. Create both domains in Dokploy before deploying.
MEDUSA_BACKEND_URL=https://api.shop.web-father.ir
MEDUSA_STOREFRONT_URL=https://shop.web-father.ir
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.shop.web-father.ir
NEXT_PUBLIC_BASE_URL=https://shop.web-father.ir

# Medusa CORS. Do not add trailing slashes.
STORE_CORS=https://shop.web-father.ir
ADMIN_CORS=https://api.shop.web-father.ir
AUTH_CORS=https://shop.web-father.ir,https://api.shop.web-father.ir

# Optional overrides (these defaults are already in docker-compose.yml).
POSTGRES_DB=medusa
POSTGRES_USER=medusa
NEXT_PUBLIC_DEFAULT_REGION=dk
LOG_LEVEL=info
MEDUSA_DISABLE_TELEMETRY=true
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional payment provider variables. Set only for the provider you enable.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# File storage defaults to a persistent local Docker volume. For S3-compatible
# production storage, set FILE_PROVIDER=s3 and configure all values below.
FILE_PROVIDER=local
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false

# Optional Next.js image-host pattern used only with Medusa Cloud storage.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
